                    "$ref": "#/components/schemas/SeasonResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/leagues/{leagueId}/seasons/{seasonId}/stats": {
      "get": {
        "tags": [
          "Seasons"
        ],
        "summary": "Golden Boot / Best Defense / head-to-head for one past season — owner only",
        "operationId": "getPastSeasonStats",
        "parameters": [
          {
            "name": "leagueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "seasonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueStatsResponse"
                }
              }
            }
          }
        }
