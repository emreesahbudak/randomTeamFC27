{
  "openapi": "3.1.0",
  "info": {
    "title": "FC27 Random Team & League Manager API",
    "description": "Backend for the FC27 random team draw and friend-league tracker",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "League Types",
      "description": "Team category lookup (e.g. \"Premier League\") — prevents typo-duplicated categories"
    },
    {
      "name": "Matches",
      "description": "Recorded match results within a league — a row only ever exists once a final score is registered. Owner only."
    },
    {
      "name": "Auth",
      "description": "Google / Email OTP / SMS OTP login, refresh-token rotation, logout"
    },
    {
      "name": "Leagues",
      "description": "A friend group's league — container for players and recorded matches. Requires authentication (no guest access); every operation is scoped to leagues the caller owns."
    },
    {
      "name": "Seasons",
      "description": "Past (closed) seasons of a league — frozen standings/matches from before each \"reset league\". Owner only."
    },
    {
      "name": "Standings",
      "description": "League table and stat badges — always computed live from recorded matches, never stored. Owner only."
    },
    {
      "name": "Teams",
      "description": "Team pool used by the wheel, managed via full CRUD by admins"
    },
    {
      "name": "Players",
      "description": "A league's roster — a display name only, optionally linked to a registered user. Owner only."
    }
  ],
  "paths": {
    "/api/teams/{id}": {
      "get": {
        "tags": [
          "Teams"
        ],
        "summary": "Get a single team by id — public",
        "operationId": "getTeam",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Teams"
        ],
        "summary": "Replace every field of a team — ADMIN only",
        "operationId": "replaceTeam",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Teams"
        ],
        "summary": "Deactivate a team (soft delete — preserves match history) — ADMIN only",
        "operationId": "deactivateTeam",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "Teams"
        ],
        "summary": "Update only the given fields of a team (null = unchanged) — ADMIN only",
        "operationId": "patchTeam",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/teams": {
      "get": {
        "tags": [
          "Teams"
        ],
        "summary": "List teams, optionally filtered by star level(s) and/or league type — public, used by the wheel including for guests. Only active teams unless includeInactive=true (admin management view).",
        "operationId": "listTeams",
        "parameters": [
          {
            "name": "stars",
            "in": "query",
            "description": "Comma-separated star levels, e.g. 2,3,4",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "leagueTypeId",
            "in": "query",
            "description": "Id from GET /api/league-types",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeInactive",
            "in": "query",
            "description": "Include deactivated teams too — for the admin management view",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TeamResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Teams"
        ],
        "summary": "Create a team — ADMIN only",
        "operationId": "createTeam",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leagues": {
      "get": {
        "tags": [
          "Leagues"
        ],
        "summary": "List leagues owned by the current user — requires auth",
        "operationId": "listMyLeagues",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeagueResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Leagues"
        ],
        "summary": "Create a league owned by the current user — requires auth",
        "operationId": "createLeague",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeagueCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leagues/{leagueId}/players": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "List the league's roster — owner only. Only active players unless includeInactive=true",
        "operationId": "listPlayers",
        "parameters": [
          {
            "name": "leagueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeInactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlayerResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Players"
        ],
        "summary": "Add a player to the league's roster — owner only. 400 if the display name is already used in this league",
        "operationId": "addPlayer",
        "parameters": [
          {
            "name": "leagueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leagues/{leagueId}/matches": {
      "get": {
        "tags": [
          "Matches"
        ],
        "summary": "List the league's recorded matches, most recent first — owner only",
        "operationId": "listMatches",
        "parameters": [
          {
            "name": "leagueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Matches"
        ],
        "summary": "Register a final score between two of the league's players (the wheel's draw) — owner only",
        "operationId": "recordMatch",
        "parameters": [
          {
            "name": "leagueId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leagues/{id}/reset": {
      "post": {
        "tags": [
          "Leagues"
        ],
        "summary": "Close the league's current season and open a new one — current standings/matches go back to zero, but the closed season's scores/standings stay browsable under GET /api/leagues/{id}/seasons (\"Geçmiş Ligler\"); the league and its player roster are kept — owner only",
        "operationId": "resetLeague",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/league-types": {
      "get": {
        "tags": [
          "League Types"
        ],
        "summary": "List all league types, alphabetically — public, used to populate the team form's dropdown",
        "operationId": "listLeagueTypes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeagueTypeResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "League Types"
        ],
        "summary": "Create a new league type — ADMIN only. 400 if the name already exists (case-insensitive)",
        "operationId": "createLeagueType",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeagueTypeCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueTypeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Rotate a refresh token (body or cookie) for a new access+refresh pair — public",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/otp/sms/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify the texted code and sign in (or register) — public",
