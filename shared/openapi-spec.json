                }
              }
            }
          }
        }
      }
    },
    "/api/auth/otp/email/send": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Send a 6-digit email login code — public, rate-limited",
        "operationId": "sendEmailOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailOtpSendRequest"
